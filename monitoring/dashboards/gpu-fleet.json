      },
      "pluginVersion": "13.1.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "DCGM_FI_DEV_GPU_TEMP{node=\"$node\"}",
