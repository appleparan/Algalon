        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "GPU power draw for the job. slurm-job-exporter reports NVML milliwatts, so the query divides by 1000 to plot watts. Separate panel from GPU memory by design — no dual axes.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
