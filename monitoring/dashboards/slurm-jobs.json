        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "13.1.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "slurm_job_utilization_gpu{slurmjobid=\"$job_id\"}",
          "instant": false,
          "legendFormat": "GPU {{gpu}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "GPU utilization per GPU",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
