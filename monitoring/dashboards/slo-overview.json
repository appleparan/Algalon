      "pluginVersion": "13.1.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "avg_over_time(algalon:sli:exporter_availability[30d])",
          "instant": true,
          "legendFormat": "Exporter availability",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Exporter availability - 30d",
      "type": "stat"
    },
    {
