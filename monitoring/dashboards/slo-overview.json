          "editorMode": "code",
          "expr": "avg_over_time(algalon:sli:nfs_latency_ok[30d])",
          "instant": true,
          "legendFormat": "NFS latency",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "NFS latency - 30d",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Fraction of each 30-day error budget still unspent: 100% means no bad minutes at all, 0% means the budget for the window is gone and the next regression breaks the SLO. Below 20% is the signal to stop shipping change and spend the time on reliability instead.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "options": {
        "displayMode": "lcd",
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "pluginVersion": "13.1.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "clamp_min((avg_over_time(algalon:sli:slurm_node_availability[30d]) - 0.99) / (1 - 0.99), 0)",
          "instant": true,
          "legendFormat": "Slurm node availability",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "clamp_min((avg_over_time(algalon:sli:exporter_availability[30d]) - 0.995) / (1 - 0.995), 0)",
          "instant": true,
          "legendFormat": "Exporter availability",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "clamp_min((avg_over_time(algalon:sli:gpu_health[30d]) - 0.99) / (1 - 0.99), 0)",
          "instant": true,
          "legendFormat": "GPU health",
          "range": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "clamp_min((avg_over_time(algalon:sli:nfs_latency_ok[30d]) - 0.995) / (1 - 0.995), 0)",
          "instant": true,
          "legendFormat": "NFS latency",
          "range": false,
          "refId": "D"
        }
      ],
      "title": "Error budget remaining (30d)",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
