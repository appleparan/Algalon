          },
          "editorMode": "code",
          "expr": "clamp_min(sum(delta(slurm_job_count_per_state{state=\"failed\"}[24h])), 0) or vector(0)",
          "instant": true,
          "legendFormat": "failed",
          "range": false,
          "refId": "A"
        }
      ],
