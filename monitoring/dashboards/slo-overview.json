          "sort": "desc"
        }
      },
      "pluginVersion": "13.1.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "algalon:sli:slurm_node_availability",
          "instant": false,
          "legendFormat": "Slurm node availability",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
