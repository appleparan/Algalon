{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Symptom-first entry point (L0): is the cluster serving its users? Four 0-1 SLIs recorded as algalon:sli:*, their 30-day compliance against the SLO targets, and the error budget left to spend.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "algalon"
      ],
      "targetBlank": false,
      "title": "Algalon dashboards",
      "tooltip": "Drill down into the fleet, queue and node views",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Share of Slurm nodes able to accept work (DOWN and DRAIN both count as unavailable), averaged over 30 days. Empty without the Slurm queue exporter - absent means unmeasured, not healthy.\n\nSLO target: 0.99.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 3,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.1.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "avg_over_time(algalon:sli:slurm_node_availability[30d])",
          "instant": true,
          "legendFormat": "Slurm node availability",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Slurm node availability - 30d",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Share of scrape targets answering, averaged over 30 days. This is the SLI for Algalon itself: every other number on this page is only as trustworthy as this one.\n\nSLO target: 0.995.",
