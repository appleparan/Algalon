          "legendFormat": "GPU health",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "GPU health - 30d",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Share of active NFS (instance, operation) paths inside the 100ms/op budget, averaged over 30 days. An idle filesystem counts as served. Requires node_exporter --collector.mountstats.\n\nSLO target: 0.995.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 3,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          },
          "unit": "percentunit"
