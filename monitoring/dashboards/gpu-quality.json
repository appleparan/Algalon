{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Is the fleet's GPU time actually doing work? DCGM_FI_DEV_GPU_UTIL only says a kernel was resident on the device - a GPU starved by its dataloader reads 100%. This dashboard walks the four layers of utilization quality: allocated (a job holds it), busy (a kernel is resident), actually computing (warps are executing), and computing efficiently (tensor cores, memory bandwidth, power against TDP). The gap between layers is the waste. It is the outcome measure for the scheduler policy decided on Algalon / Scheduler Analytics: good QoS policy shows up here as GPU-hours that do real work.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "algalon"
      ],
      "targetBlank": false,
      "title": "Algalon dashboards",
      "tooltip": "Drill down into the fleet, queue and node views",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Fraction of time at least one warp was executing, averaged over every GPU. This is layer 3 of the utilization hierarchy - the first layer that means work is actually happening. Compare it with the GPU utilization line below: the gap between them is the fleet's hollow running.\n\nRequires the DCGM_FI_PROF_* profiling fields in monitoring/exporters/dcgm-counters.csv (Volta or newer; conflicts with a concurrent Nsight/profiler session). Empty without them.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.1.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "avg(DCGM_FI_PROF_SM_ACTIVE)",
          "instant": true,
          "legendFormat": "SM active",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Fleet SM active",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Fraction of time the tensor pipe was engaged, fleet-wide. Layer 4: not just computing, but computing on the units the hardware was bought for. A training fleet running fp32 kernels, or one bottlenecked on memory, sits near zero here while SM active looks healthy.\n\nRequires the DCGM_FI_PROF_* profiling fields in monitoring/exporters/dcgm-counters.csv (Volta or newer; conflicts with a concurrent Nsight/profiler session). Empty without them.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "green",
                "value": 0.3
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.1.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "avg(DCGM_FI_PROF_PIPE_TENSOR_ACTIVE)",
          "instant": true,
          "legendFormat": "tensor active",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Tensor core active",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Average power draw against the enforced limit. The cheapest quality proxy there is, and it needs no profiling fields: a GPU doing real training work sits around 0.7-1.0, while one holding an allocation at idle clocks sits at 0.1-0.3. Read a low value here together with a high GPU utilization as hollow running.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.4
              },
              {
                "color": "green",
                "value": 0.65
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.1.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "avg(DCGM_FI_DEV_POWER_USAGE / DCGM_FI_DEV_ENFORCED_POWER_LIMIT)",
          "instant": true,
          "legendFormat": "power / TDP",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Power / TDP",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "GPUs claiming above 80% utilization while under 20% of the time has a warp executing. The `and` matches the two series one-to-one per {instance, gpu} - both come from the same dcgm-exporter with identical labelsets, and set operators ignore the metric name, so each GPU is judged against itself.\n\nEvery GPU counted here is being paid for and not used. GpuBusyButHollow pages on the same condition at node level after 30 minutes.\n\nRequires the DCGM_FI_PROF_* profiling fields in monitoring/exporters/dcgm-counters.csv (Volta or newer; conflicts with a concurrent Nsight/profiler session). Empty without them.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.1.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count(DCGM_FI_DEV_GPU_UTIL > 80 and DCGM_FI_PROF_SM_ACTIVE < 0.2) or vector(0)",
          "instant": true,
          "legendFormat": "hollow GPUs",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Busy-but-hollow GPUs",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "The centrepiece of this dashboard. DCGM_FI_DEV_GPU_UTIL only reports that a kernel was resident on the device during the sample - a job whose dataloader cannot keep up, or one blocked in an NCCL all-reduce, keeps a kernel resident and reads near 100% while computing nothing. SM active is the layer below: is a warp actually running?\n\nThe gap between the two lines IS the waste signal. A wide, persistent gap means the bottleneck is input pipeline, CPU or interconnect - not the GPU, and not something more GPUs will fix. Utilization is divided by 100 so both lines share one 0-1 axis.\n\nRequires the DCGM_FI_PROF_* profiling fields in monitoring/exporters/dcgm-counters.csv (Volta or newer; conflicts with a concurrent Nsight/profiler session). Empty without them.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "fraction",
            "axisPlacement": "left",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "decimals": 3
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "13.1.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "avg(DCGM_FI_DEV_GPU_UTIL) / 100",
          "instant": false,
          "legendFormat": "GPU util (claimed busy)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "avg(DCGM_FI_PROF_SM_ACTIVE)",
          "instant": false,
          "legendFormat": "SM active (actually computing)",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Claimed vs actual: GPU util vs SM active",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "p10, p50 and p90 of power draw against the enforced limit, across every GPU in the fleet. A healthy training fleet clusters high and tight. A p10 dragging along the bottom while p50 stays high is the straggler pattern - a handful of GPUs idling inside jobs that hold them.\n\nThis panel needs no profiling fields: POWER_USAGE and ENFORCED_POWER_LIMIT are in the base counter set, which makes it the one quality signal available on a fleet that cannot enable DCP.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "power / TDP",
            "axisPlacement": "left",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "decimals": 2
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
