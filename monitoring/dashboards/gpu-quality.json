            ]
          },
          "unit": "percentunit",
          "min": 0,
          "decimals": 3
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "13.1.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "avg by (node) (DCGM_FI_PROF_PIPE_TENSOR_ACTIVE)",
          "instant": false,
          "legendFormat": "{{node}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Tensor core activity by node",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Memory-bound or compute-bound, fleet-wide. DRAM active well above SM active means the kernels are waiting on device memory rather than computing - the shape of an unfused, memory-bandwidth-limited workload. SM active well above DRAM active is the compute-bound case, which is where you want a training fleet to sit.\n\nBoth low, with GPU utilization high, is the memory-holding waste pattern: a job parked on the device doing neither.\n\nRequires the DCGM_FI_PROF_* profiling fields in monitoring/exporters/dcgm-counters.csv (Volta or newer; conflicts with a concurrent Nsight/profiler session). Empty without them.",
      "fieldConfig": {
